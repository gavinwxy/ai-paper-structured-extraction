{
  "type": "object",
  "title": "Context Section Output",
  "description": "Structured output schema for the context section section extraction. Typed unit arrays: contexts. Valid unit types: Context.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "covers_entries",
        "contexts",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "context"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "covers_entries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plan item IDs covered by this section"
        },
        "contexts": {
          "type": "array",
          "description": "Context units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "context_kind",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Context"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "context_kind": {
                "type": "string",
                "enum": [
                  "background",
                  "gap",
                  "motivation",
                  "challenge",
                  "assumption"
                ],
                "description": "Argumentative role of the context premise"
              },
              "description": {
                "type": "string",
                "description": "Single-sentence prose statement of the premise"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "Section-local links between units",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "supports",
                  "part_of",
                  "compares_to"
                ],
                "description": "Section-local relation. Recommended for context: supports."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              }
            }
          }
        }
      }
    }
  }
}
