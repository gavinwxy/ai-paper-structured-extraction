{
  "type": "object",
  "title": "Claim Section Output",
  "description": "Structured output schema for the claim section content extraction. Typed unit arrays: claims. Valid unit types: Claim. Authors relations.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "claims",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "claim"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "claims": {
          "type": "array",
          "description": "Claim units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "statement",
              "claim_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Claim"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "statement": {
                "type": "string",
                "description": "The claim as a single declarative sentence"
              },
              "claim_kind": {
                "type": "string",
                "enum": [
                  "descriptive",
                  "mechanistic",
                  "comparative",
                  "modeling",
                  "ablation_finding",
                  "failure_mode"
                ],
                "description": "Classification of the claim"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "description": "Edges this claim section authors. Lifted into the global relations[] during assembly. Empty array when none apply.",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id",
              "provenance"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "about",
                  "supports"
                ],
                "description": "about = a Claim is about a Method/Entity/Metric; supports = a Metric or Claim supports a Claim."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
