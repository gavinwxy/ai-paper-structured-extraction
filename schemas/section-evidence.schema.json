{
  "type": "object",
  "title": "Evidence Section Output",
  "description": "Structured output schema for the evidence section content extraction. Typed unit arrays: metrics, conditions, claims, entities. Valid unit types: Metric, Condition, Claim, Entity. Authors claim-centric relations.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "metrics",
        "conditions",
        "claims",
        "entities",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "evidence"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "metrics": {
          "type": "array",
          "description": "Metric units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "unit",
              "context_ids",
              "scores"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Metric"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the metric"
              },
              "unit": {
                "type": "string",
                "description": "Non-empty measurement unit such as %, ms, BLEU, F1, perplexity, or unitless"
              },
              "context_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of local Condition units scoping this metric; empty when none apply"
              },
              "comparison_direction": {
                "type": "string",
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "target",
                  "unspecified"
                ],
                "description": "Whether higher or lower values are preferred; omit when unspecified"
              },
              "value_type": {
                "type": "string",
                "enum": [
                  "scalar",
                  "range",
                  "ratio",
                  "categorical"
                ],
                "description": "Shape of the metric value; omit when unspecified"
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "variant",
                    "value",
                    "variance"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "description": "Method variant or configuration name"
                    },
                    "value": {
                      "type": "string",
                      "description": "Reported score encoded as a string, including numeric values"
                    },
                    "variance": {
                      "type": "string",
                      "description": "Uncertainty (e.g. '\u00b1 0.3'); empty string when unreported"
                    }
                  }
                },
                "description": "Flat array of reported scores for method-family variants under this metric"
              }
            }
          }
        },
        "conditions": {
          "type": "array",
          "description": "Condition units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "condition_kind",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Condition"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "condition_kind": {
                "type": "string",
                "enum": [
                  "experimental",
                  "boundary",
                  "evaluation_setup",
                  "hyperparameter"
                ],
                "description": "Operational role of the constraint"
              },
              "description": {
                "type": "string",
                "description": "Single-sentence prose statement of the constraint"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "description": "Claim units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "statement",
              "claim_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Claim"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "statement": {
                "type": "string",
                "description": "The claim as a single declarative sentence"
              },
              "claim_kind": {
                "type": "string",
                "enum": [
                  "descriptive",
                  "mechanistic",
                  "causal",
                  "correlational",
                  "comparative",
                  "modeling",
                  "ablation_finding",
                  "failure_mode"
                ],
                "description": "Classification of the claim"
              },
              "polarity": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "neutral",
                  "mixed"
                ],
                "description": "Directional assertion of the claim; omit when unspecified"
              },
              "novelty": {
                "type": "string",
                "enum": [
                  "original",
                  "replication",
                  "citation",
                  "synthesis"
                ],
                "description": "Whether the claim is original to this paper; omit when unspecified"
              },
              "epistemic_status": {
                "type": "string",
                "enum": [
                  "hypothesis",
                  "conclusion",
                  "established_fact"
                ],
                "description": "Confidence level of the claim; omit when unspecified"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "description": "Entity units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "entity_class"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Entity"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the entity"
              },
              "entity_class": {
                "type": "string",
                "enum": [
                  "dataset",
                  "benchmark",
                  "model",
                  "task",
                  "hardware"
                ],
                "description": "Classification of the entity"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "description": "Claim-centric edges this evidence section authors. Lifted into the global relations[] during assembly. Empty array when none apply.",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id",
              "provenance"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "about",
                  "supports"
                ],
                "description": "about = a Claim is about a Method/Entity/Metric; supports = a Metric or Claim supports a Claim."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
