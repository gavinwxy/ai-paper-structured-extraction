{
  "type": "object",
  "title": "Evidence Section Output",
  "description": "Structured output schema for the evidence section content extraction. Typed unit arrays: metrics, settings, claims, entities. Valid unit types: Metric, Setting, Claim, Entity. Authors claim-centric relations.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "metrics",
        "settings",
        "claims",
        "entities",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "evidence"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "metrics": {
          "type": "array",
          "description": "Metric units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "unit",
              "setting_ids",
              "scores"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Metric"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the metric"
              },
              "unit": {
                "type": "string",
                "description": "Non-empty measurement unit such as %, ms, BLEU, F1, perplexity, or unitless"
              },
              "setting_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of local Setting units scoping this metric; empty when none apply"
              },
              "comparison_direction": {
                "type": "string",
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "target",
                  "unspecified"
                ],
                "description": "Whether higher or lower values are preferred; omit when unspecified"
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "variant",
                    "value",
                    "variance",
                    "system_id",
                    "setting_id"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "description": "System name for this score row as the paper labels it \u2014 a method-family variant/configuration or a compared-against baseline (e.g. 'Transformer (big)', 'GNMT')"
                    },
                    "value": {
                      "type": "string",
                      "description": "Reported score encoded as a string, including numeric values"
                    },
                    "variance": {
                      "type": "string",
                      "description": "Uncertainty (e.g. '\u00b1 0.3'); empty string when unreported"
                    },
                    "system_id": {
                      "type": "string",
                      "description": "ID of the Method unit this row reports \u2014 the contribution variant or the compared-against baseline (e.g. 'mth:transformer', 'mth:gnmt'). Empty string when no node represents this row's system (e.g. an ensemble-of-baselines the census did not capture)."
                    },
                    "setting_id": {
                      "type": "string",
                      "description": "ID of the local Setting unit this row was measured under (the dataset split / language pair / protocol), when one Metric spans several. Empty string when the metric's own setting_ids already scope every row."
                    }
                  }
                },
                "description": "Flat array of reported scores under this metric \u2014 one row per system, covering the method family's own variants and every compared-against baseline"
              }
            }
          }
        },
        "settings": {
          "type": "array",
          "description": "Setting units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "setting_kind",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Setting"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "setting_kind": {
                "type": "string",
                "enum": [
                  "data_split",
                  "inference_protocol",
                  "training_config",
                  "ensembling",
                  "population"
                ],
                "description": "Which axis of the evaluation this setup constrains: data_split, inference_protocol, training_config, ensembling, or population"
              },
              "description": {
                "type": "string",
                "description": "Single-sentence prose statement of the operational constraint that scopes a metric \u2014 the concrete dataset split, protocol, population, or hyperparameter"
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "description": "Claim units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "statement",
              "claim_kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Claim"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "statement": {
                "type": "string",
                "description": "The claim as a single declarative sentence"
              },
              "claim_kind": {
                "type": "string",
                "enum": [
                  "descriptive",
                  "mechanistic",
                  "comparative",
                  "modeling",
                  "ablation_finding",
                  "failure_mode"
                ],
                "description": "Classification of the claim"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "description": "Entity units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "entity_class"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Entity"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the entity"
              },
              "entity_class": {
                "type": "string",
                "enum": [
                  "dataset",
                  "benchmark",
                  "task"
                ],
                "description": "Classification of the entity"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "description": "Claim-centric edges this evidence section authors. Lifted into the global relations[] during assembly. Empty array when none apply.",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id",
              "provenance"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "about",
                  "supports"
                ],
                "description": "about = a Claim is about a Method/Entity/Metric; supports = a Metric or Claim supports a Claim."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\\u00a71', '\\u00a72']",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
