{
  "type": "object",
  "title": "Analysis Section Output",
  "description": "Structured output schema for the analysis section section extraction. Typed unit arrays: claims, metrics, entities. Valid unit types: Claim, Metric, Entity.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "covers_entries",
        "claims",
        "metrics",
        "entities",
        "links"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "analysis"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "covers_entries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plan item IDs covered by this section"
        },
        "claims": {
          "type": "array",
          "description": "Claim units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "statement",
              "claim_kind",
              "target_ids"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Claim"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "statement": {
                "type": "string",
                "description": "The claim as a single declarative sentence"
              },
              "claim_kind": {
                "type": "string",
                "enum": [
                  "descriptive",
                  "mechanistic",
                  "causal",
                  "correlational",
                  "comparative",
                  "modeling",
                  "ablation_finding",
                  "failure_mode"
                ],
                "description": "Classification of the claim"
              },
              "target_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of entities or methods the claim is about"
              },
              "polarity": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "neutral",
                  "mixed"
                ],
                "description": "Directional assertion of the claim; omit when unspecified"
              },
              "novelty": {
                "type": "string",
                "enum": [
                  "original",
                  "replication",
                  "citation",
                  "synthesis"
                ],
                "description": "Whether the claim is original to this paper; omit when unspecified"
              },
              "epistemic_status": {
                "type": "string",
                "enum": [
                  "hypothesis",
                  "conclusion",
                  "established_fact"
                ],
                "description": "Confidence level of the claim; omit when unspecified"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "description": "Metric units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "unit",
              "subject_id",
              "context_ids",
              "scores"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Metric"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the metric"
              },
              "unit": {
                "type": "string",
                "description": "Non-empty measurement unit such as %, ms, BLEU, F1, perplexity, or unitless"
              },
              "subject_id": {
                "type": "string",
                "description": "ID of the unit being measured"
              },
              "context_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 0,
                "description": "Must be an empty array: analysis sections have no local Conditions, so analysis metrics carry no context_ids."
              },
              "evaluated_on": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "IDs of local dataset/benchmark Entity units this metric was measured on; omit entirely when no such local Entity exists"
              },
              "comparison_direction": {
                "type": "string",
                "enum": [
                  "higher_is_better",
                  "lower_is_better",
                  "target",
                  "unspecified"
                ],
                "description": "Whether higher or lower values are preferred; omit when unspecified"
              },
              "value_type": {
                "type": "string",
                "enum": [
                  "scalar",
                  "range",
                  "ratio",
                  "categorical"
                ],
                "description": "Shape of the metric value; omit when unspecified"
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "variant",
                    "value",
                    "variance"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "variant": {
                      "type": "string",
                      "description": "Method variant or configuration name"
                    },
                    "value": {
                      "type": "string",
                      "description": "Reported score encoded as a string, including numeric values"
                    },
                    "variance": {
                      "type": "string",
                      "description": "Uncertainty (e.g. '\u00b1 0.3'); empty string when unreported"
                    }
                  }
                },
                "description": "Flat array of reported scores for method-family variants under this metric"
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "description": "Entity units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "entity_class"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Entity"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the entity"
              },
              "entity_class": {
                "type": "string",
                "enum": [
                  "dataset",
                  "benchmark",
                  "model",
                  "task",
                  "hardware"
                ],
                "description": "Classification of the entity"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "description": "Section-local links between units",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "supports",
                  "part_of",
                  "compares_to"
                ],
                "description": "Section-local relation. Recommended for analysis: supports, compares_to."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              }
            }
          }
        }
      }
    }
  }
}
