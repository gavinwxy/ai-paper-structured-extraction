{
  "type": "object",
  "title": "Method Section Output",
  "description": "Structured output schema for the method section content extraction. Typed unit arrays: methods. Valid unit types: Method.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "methods"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "method"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "methods": {
          "type": "array",
          "description": "Method units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "name",
              "method_kind",
              "description",
              "implementation_notes"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Method"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Source references for this unit",
                "items": {
                  "type": "object",
                  "required": [
                    "source_kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "source_kind": {
                      "type": "string",
                      "enum": [
                        "sentence",
                        "table",
                        "figure",
                        "appendix",
                        "caption",
                        "equation",
                        "supplementary_material"
                      ],
                      "description": "Source marker kind"
                    },
                    "source": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Section markers such as ['\\u00a71', '\\u00a72']"
                    }
                  }
                }
              },
              "name": {
                "type": "string",
                "description": "Name of the method"
              },
              "method_kind": {
                "type": "string",
                "enum": [
                  "algorithm",
                  "model_architecture",
                  "protocol",
                  "software_system",
                  "training_strategy",
                  "objective_function"
                ],
                "description": "Classification of the method"
              },
              "description": {
                "type": "string",
                "description": "Prose description of the method; empty string when unknown"
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Inputs to the method; omit when the paper does not state them"
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Outputs of the method; omit when the paper does not state them"
              },
              "formulas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "expression",
                    "symbols"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Short label for the equation, e.g. 'Scaled Dot-Product Attention'; empty string when unnamed"
                    },
                    "expression": {
                      "type": "string",
                      "description": "The equation itself, as LaTeX or plain text, e.g. 'softmax(QK^T/sqrt(d_k))V'"
                    },
                    "symbols": {
                      "type": "array",
                      "description": "Definitions of the symbols and variables appearing in the expression; empty array when the expression introduces none",
                      "items": {
                        "type": "object",
                        "required": [
                          "symbol",
                          "description"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "symbol": {
                            "type": "string",
                            "description": "A symbol or variable from the expression, e.g. 'Q', 'd_k', 'W^O'"
                          },
                          "description": {
                            "type": "string",
                            "description": "What the symbol denotes, e.g. 'query matrix', 'dimension of the keys'"
                          }
                        }
                      }
                    }
                  }
                },
                "description": "Key defining equations of the method, each with a short label; omit when the method states none"
              },
              "objective_function": {
                "type": "object",
                "required": [
                  "expression",
                  "description",
                  "symbols"
                ],
                "additionalProperties": false,
                "properties": {
                  "expression": {
                    "type": "string",
                    "description": "The objective or loss as LaTeX or plain text, e.g. 'L = -sum log P(y|x)'"
                  },
                  "description": {
                    "type": "string",
                    "description": "What the objective optimizes; empty string when only the formula is reported"
                  },
                  "symbols": {
                    "type": "array",
                    "description": "Definitions of the symbols and variables appearing in the expression; empty array when the expression introduces none",
                    "items": {
                      "type": "object",
                      "required": [
                        "symbol",
                        "description"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "symbol": {
                          "type": "string",
                          "description": "A symbol or variable from the expression, e.g. 'Q', 'd_k', 'W^O'"
                        },
                        "description": {
                          "type": "string",
                          "description": "What the symbol denotes, e.g. 'query matrix', 'dimension of the keys'"
                        }
                      }
                    }
                  }
                },
                "description": "The optimization objective or loss the method minimizes/maximizes; omit when the method defines none"
              },
              "implementation_notes": {
                "type": "string",
                "description": "Key implementation details; empty string when none are reported"
              }
            }
          }
        }
      }
    }
  }
}
