{
  "type": "object",
  "title": "Problem Section Output",
  "description": "Structured output schema for the problem section content extraction. Typed unit arrays: problems. Valid unit types: Problem. Authors relations.",
  "required": [
    "section"
  ],
  "additionalProperties": false,
  "properties": {
    "section": {
      "type": "object",
      "required": [
        "section_type",
        "anchor_id",
        "problems",
        "relations"
      ],
      "additionalProperties": false,
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "problem"
          ]
        },
        "anchor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
          "description": "ID of the unit that anchors this section; it must be defined in one typed unit array"
        },
        "problems": {
          "type": "array",
          "description": "Problem units extracted for this section",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "provenance",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Unit identifier in lowercase prefix:descriptor format"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Problem"
                ],
                "description": "Unit type discriminator"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\u00a71', '\u00a72']",
                "items": {
                  "type": "string"
                }
              },
              "description": {
                "type": "string",
                "description": "The research problem in one or two sentences \u2014 the unresolved question or unmet need the paper addresses, with the necessary background folded into the prose"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "description": "Edges this problem section authors. Lifted into the global relations[] during assembly. Empty array when none apply.",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "relation",
              "target_id",
              "provenance"
            ],
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Source unit ID"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "motivates"
                ],
                "description": "motivates = a Problem motivates the Method/ExperimentSetup that addresses it."
              },
              "target_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
                "description": "Target unit ID"
              },
              "provenance": {
                "type": "array",
                "description": "Location markers for this unit: top-level section anchors such as ['\u00a71', '\u00a72']",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
